# Vercel + Supabase only. Never put service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The Vercel Marketplace's NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
# Enable only after applying the RLS migration and testing confirmation emails.
NEXT_PUBLIC_CLOUD_AUTH_READY=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set to the final public URL, without a trailing slash.
PACEPREP_SITE_URL=
